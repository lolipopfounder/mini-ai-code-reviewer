# Local Ollama, replace with other here
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3-coder:30b

LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=5000

# only works on models that support json mode like qwen2.5-coder (not qwen3.5)
LLM_JSON_MODE=true

LLM_PROMPT_VERSION=v2
CACHE_TTL_S=3600
CACHE_MAX_ITEMS=1000
CORS_ORIGINS=["http://localhost:5173"]